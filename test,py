#!/usr/bin/env python3
# -*- coding: utf-8 -*-

import time
from src.drivers.ultrasonic import UltrasonicDriver
import yaml

def main():
    print("\n==============================")
    print("   🔵 Ultrasonic Test Reader")
    print("==============================\n")

    # 你的 ultrasonic.yaml 配置路径
    cfg_path = "/home/pi/Downloads/MT3900/src/aas/ultrasonic.yaml"

    # 读取 config
    cfg = yaml.safe_load(open(cfg_path, "r"))

    # 初始化 driver
    driver = UltrasonicDriver(cfg)
    print("Ultrasonic driver initialized.\n")

    try:
        while True:
            value = driver.read_value()
            if value is None:
                print("❌ Read failed")
            else:
                print(f"📏 Distance = {value:.3f} m")

            time.sleep(0.5)

    except KeyboardInterrupt:
        print("\nStopped by user.")

if __name__ == "__main__":
    main()
